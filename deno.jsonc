{
    "workspace": [
        "./workspaces/enums",
        "./workspaces/utils",
        "./workspaces/math",
        "./workspaces/types",
        "./workspaces/deno-server",
        "./workspaces/core",
        "./workspaces/canvas",
        "./workspaces/tools",
        "./workspaces/physics",
        "./workspaces/svg",
        "./workspaces/drawing",
        "./workspaces/html",
        "./workspaces/playground",
        "./workspaces/world-generation"
    ],
    "tasks": {
        "bench": "deno bench",
        "bench:utils": "deno bench --filter **/utils/**/*.bench.ts",
        "check": "deno check workspaces/**/src/**/*.ts && deno lint && deno fmt --check",
        "check:fix": "deno check workspaces/**/src/**/*.ts  && deno lint --fix && deno fmt",
        "doc": "deno doc --html --name=\"@g43/tools\" --output=docs workspaces/canvas/src/index.ts workspaces/math/src/index.ts workspaces/types/src/index.ts workspaces/tools/src/index.ts workspaces/core/src/index.ts workspaces/deno-server/src/index.ts workspaces/enums/src/index.ts workspaces/utils/src/index.ts workspaces/physics/src/index.ts workspaces/world-generation/src/index.ts workspaces/svg/src/index.ts workspaces/drawing/src/index.ts",
        "doc:lint": "deno doc --lint --html --name=\"@g43/tools\" --output=docs workspaces/canvas/src/index.ts workspaces/math/src/index.ts workspaces/types/src/index.ts workspaces/tools/src/index.ts workspaces/core/src/index.ts workspaces/deno-server/src/index.ts workspaces/enums/src/index.ts workspaces/utils/src/index.ts workspaces/physics/src/index.ts workspaces/world-generation/src/index.ts workspaces/svg/src/index.ts workspaces/drawing/src/index.ts",
        "test": "deno test --parallel --doc workspaces/**/src/**/*.spec.ts",
        "test:coverage": "deno test --doc --parallel --clean --coverage workspaces/**/src/**/*.spec.ts",
        "coverage": {
            "dependencies": ["test:coverage"],
            "command": "deno coverage --html --exclude=\"(spec|bench)\\.(js|mjs|ts|jsx|tsx)$\""
        },
        "coverage:lcov": {
            "dependencies": ["test:coverage"],
            "command": "deno coverage --lcov --output=coverage/lcov.info --exclude=\"(spec|bench)\\.(js|mjs|ts|jsx|tsx)$\""
        },
        "serve:doc": {
            "dependencies": ["doc"],
            "command": "deno run --allow-net --watch --allow-read utils/serve-doc.ts"
        },
        "serve:coverage": {
            "dependencies": ["test:coverage", "coverage"],
            "command": "deno run --allow-net --watch --allow-read utils/serve-coverage.ts"
        },
        "release:patch": "deno -A ./utils/bump-versions.ts --skip playground  patch",
        // fresh
        "fresh:check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
        "fresh:cli": "echo \"import '\\$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
        "fresh:manifest": "deno task cli manifest $(pwd)",
        "fresh:start": "deno run -A --watch=workspaces/playground/static/,workspaces/playground/routes/ workspaces/playground/dev.ts",
        "fresh:build": "deno run -A dev.ts build",
        "fresh:preview": "deno run -A main.ts",
        "fresh:update": "deno run -A -r https://fresh.deno.dev/update ."
    },
    "lint": {
        "rules": {
            "exclude": ["no-explicit-any"],
            "include": [
                "no-slow-types",
                "_default-param-last",
                "no-await-in-loop",
                "___no-boolean-literal-for-arguments",
                "___no-external-import",
                "no-import-prefix",
                "_no-inferrable-types",
                "no-non-null-asserted-optional-chain",
                "no-self-compare",
                "no-sparse-arrays",
                "no-sync-fn-in-async-fn",
                "no-throw-literal",
                "_prefer-ascii",
                "_single-var-declarator"
            ]
        },
        "include": ["workspaces/**/src/**/*.ts"],
        "exclude": ["utils", "docs", "coverage"]
    },
    "publish": {
        "exclude": ["**/*.bench.ts"]
    },
    "test": {
        "exclude": ["**/*.bench.ts"]
    },
    "bench": {
        "include": ["workspaces/**/src"]
    },
    "fmt": {
        "lineWidth": 120,
        "indentWidth": 4,
        "exclude": [
            "docs",
            "coverage"
        ]
    },
    "compilerOptions": {
        "strict": true,
        "lib": ["es2019", "dom", "deno.ns"],
        "jsx": "react-jsx",
        "erasableSyntaxOnly": true,
        "jsxImportSource": "preact"
    },
    "exclude": [
        "**/_fresh/*"
    ],
    "imports": {
        "@std/http": "jsr:@std/http@^1.1.3",
        "@std/dotenv": "jsr:@std/dotenv@0.225.8",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/path": "jsr:@std/path@1.1.6",
        "@std/testing": "jsr:@std/testing@^1.0.20",
        "@cliffy/flags": "jsr:@cliffy/flags@1.2.1",
        "@std/expect": "jsr:@std/expect@^1.0.20",
        "@g43/fresh-components": "jsr:@g43/fresh-components@0.0.5",
        "delaunator": "npm:delaunator@^5.1.0",
        "@types/delaunator": "npm:@types/delaunator@^5.0.3",
        // fresh
        "$fresh/": "https://deno.land/x/fresh@1.7.3/",
        "preact": "npm:preact@10.29.8",
        "@preact/signals": "npm:@preact/signals@2.11.2",
        "@preact/signals-core": "npm:@preact/signals-core@1.14.4",
        "tailwindcss": "npm:tailwindcss@4.3.3",
        "tailwindcss/": "npm:tailwindcss@4.3.3/",
        "tailwindcss/plugin": "npm:tailwindcss@4.3.3/plugin.js"
    },
    "nodeModulesDir": "auto"
}
