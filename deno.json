{
    "workspace": [
        "./workspaces/enums",
        "./workspaces/utils",
        "./workspaces/math",
        "./workspaces/types",
        "./workspaces/deno-server",
        "./workspaces/core",
        "./workspaces/canvas",
        "./workspaces/tools"
    ],
    "tasks": {
        "bench": "deno bench",
        "bench:utils": "deno bench --filter utils",
        "check": "deno check workspaces/**/src/**/*.ts",
        "check:fix": "deno lint --fix && deno fmt",
        "doc": "deno doc --html --name=\"@g43/tools\" --output=docs workspaces/canvas/src/index.ts workspaces/math/src/index.ts workspaces/types/src/index.ts workspaces/tools/src/index.ts workspaces/core/src/index.ts workspaces/deno-server/src/index.ts workspaces/enums/src/index.ts workspaces/utils/src/index.ts",
        "test": "deno test workspaces/**/src/**/*.spec.ts",
        "test:doc": "deno test --doc workspaces/**/src/**/*.ts",
        "test:coverage": "deno test --clean --coverage workspaces/**/src/**/*.spec.ts",
        "test:coverage:doc": "deno test --doc --coverage workspaces/**/src/**/*.ts",
        "coverage": "deno coverage --html --exclude=\"(spec|bench)\\.(js|mjs|ts|jsx|tsx)$,(core/src/index.ts)\"",
        "coverage:lcov": "deno coverage --lcov --output=coverage/lcov.info --exclude=\"(spec|bench)\\.(js|mjs|ts|jsx|tsx)$\"",
        "serve:doc": "deno run --allow-net --watch --allow-read utils/serve-doc.ts",
        "serve:coverage": "deno run --allow-net --watch --allow-read utils/serve-coverage.ts",
        "open:coverage": "deno task test:coverage && deno task coverage && deno task serve:coverage",
        "open:doc": "deno task doc && deno task serve:doc"
    },
    "lint": {
        "rules": {
            "exclude": ["no-explicit-any"]
        },
        "include": ["workspaces/**/src/**/*.ts"],
        "exclude": ["srcOld", "utils", "docs", "coverage"]
    },
    "publish": {
        "exclude": ["**/*.bench.ts"]
    },
    "test": {
        "exclude": ["**/*.bench.ts", "srcOld"]
    },
    "bench": {
        "include": ["workspaces/**/src"],
        "exclude": ["srcOld"]
    },
    "fmt": {
        "lineWidth": 120,
        "indentWidth": 4,
        "exclude": [
            "docs",
            "coverage",
            "srcOld"
        ]
    },
    "compilerOptions": {
        "strict": true,
        "lib": ["es2019", "dom"]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1.0.6",
        "@std/http": "jsr:@std/http@1.0.8",
        "@std/testing": "jsr:@std/testing@1.0.3",
        "@std/expect": "jsr:@std/expect@1.0.8"
    }
}
